DATASET_SOURCE=current
# Optional validated catalog/index bundle, loaded once at API startup:
# ACTIVE_CATALOG_MANIFEST=data/serving.json
# Match both values to the same completed index build.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDEX_PATH=data/games.index
# Multilingual alternative after building it:
# EMBED_MODEL=intfloat/multilingual-e5-small
# INDEX_PATH=data/rag-v1/games.index
# Pin to a Hugging Face commit when building a production snapshot.
# EMBED_REVISION=
EMBED_DEVICE=cpu
MAX_RETRIEVAL_CANDIDATES=1600
# Optional GPU multilingual shortlist reranker, benchmark before activation:
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_REVISION=<model commit>
RERANK_DEVICE=cpu
RERANK_TOP_N=40
# Heuristic social-discovery blend; not a validated optimum.
SOCIAL_COSINE_WEIGHT=0.95
# Required for paginated discovery of new Steam app IDs (existing-ID refresh works without it):
# STEAM_WEB_API_KEY=
ENABLE_SEARCH_HISTORY=false
ENABLE_SEARCH_LOGS=false
ENABLE_CLOUD_HISTORY=false
ENABLE_TRANSLATION=false
ENABLE_AI_FEEDBACK=false
DEMO_CATALOG=false
# Optional plain-text disclosure for a bounded initial real catalog:
# CATALOG_NOTICE=Initial Steam catalog; more games are being added.
CORS_ORIGINS=[]
# Optional authenticated history access (set locally, never commit):
# HISTORY_TOKEN=
# Optional external AI feedback/translation and cloud history:
# OPENROUTER_API_KEY=
# SUPABASE_URL=
# SUPABASE_KEY=
