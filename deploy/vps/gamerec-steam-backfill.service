[Unit]
Description=Initial resumable backfill of Steam games missing from GameRecApp
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/gamerecapp
ExecStart=/usr/bin/python3 /opt/gamerecapp/refresh-host.py --backfill
ExecStopPost=-/usr/bin/docker rm --force gamerec-steam-backfill-worker
TimeoutStartSec=infinity
Nice=10
StandardOutput=journal
StandardError=journal
